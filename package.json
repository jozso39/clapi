{
  "name": "clapi",
  "productName": "Clapi",
  "version": "0.1.0",
  "description": "A Claude-Desktop-style app for oh-my-pi (omp) sessions",
  "main": "out/main/index.js",
  "author": "Jozef \u010cambora",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --import tsx --test test/*.test.ts",
    "e2e": "node scripts/e2e.mjs",
    "package": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir",
    "install-app": "node scripts/install-app.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "clsx": "^2.1.1",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "lucide-react": "^0.511.0",
    "playwright-core": "^1.55.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "zustand": "^5.0.5"
  },
  "build": {
    "appId": "io.github.jozso39.clapi",
    "productName": "Clapi",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns"
    }
  }
}
